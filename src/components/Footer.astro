---
import { withBase } from "../lib/base-path";
const year = new Date().getFullYear();
---

<div
  class="center w-full border-t border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-900"
>
  <footer class="app-content-col app-gutter gap-6 py-8 sm:py-10">
    <div class="flex flex-wrap items-center justify-between gap-6">
      <a href={withBase("/")}>
        <span class="text-xl"
          ><span class="font-light text-gray-600 dark:text-gray-300">causa</span
          ><span
            class="text-[0.92em] font-extrabold text-gray-900 dark:text-white"
            >mortis</span
          ><span
            class="ml-1.5 text-[0.7em] font-medium text-gray-500 dark:text-gray-400"
            >RS</span
          ></span
        >
      </a>
    </div>

    <p class="max-w-140 text-sm text-gray-600 dark:text-gray-400">
      Painel de infográficos sobre mortalidade no Rio Grande do Sul e seus
      municípios. Finalidade didática e de divulgação. Réplica do projeto <a
        href="https://causamortis.net"
        target="_blank"
        rel="noopener noreferrer"
        class="underline">Causa Mortis</a
      >.
    </p>

    <p class="text-xs text-gray-500 dark:text-gray-400">
      © {year} Causa Mortis RS. Derivado de Causa Mortis (MIT). Projeto distribuído
      sob a licença MIT. O conteúdo pode ser compartilhado e reutilizado em trabalhos
      derivados, desde que a fonte seja citada.
    </p>
  </footer>
</div>
