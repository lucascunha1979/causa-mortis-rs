---
import { Check, Copy } from "@lucide/astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../components/Layout.astro";
import QualityChartCard from "../components/mortality/QualityChartCard.astro";
import YearControl from "../components/mortality/YearControl.astro";
import { formatAccessDate } from "../lib/mortality/format";

const bibtex = `@software{causamortisrs2026,
  title   = {Causa Mortis RS: mortalidade no Rio Grande do Sul, município por município},
  version = {1.0},
  year    = {2026},
  note    = {Painel interativo. Réplica geográfica de Zanchetta Jr., C.; Weise, F.; Veloso, P. Causa Mortis (https://causamortis.net), licença MIT}
}`;
---

<Layout
  title="Notas - Causa Mortis RS"
  description="De onde vêm os números do painel: fontes oficiais (SIM/DATASUS, IBGE, RIPSA), metodologia de cálculo das taxas e limitações."
>
  <Header />

  <main class="center-col gap-2 pb-8 md:gap-4">
    <div class="app-content-col">
      <div class="app-gutter flex flex-col gap-2 pt-6 pb-4 lg:pt-10">
        <h1 class="text-2xl font-bold lg:text-3xl">De onde vêm os números</h1>

        <p class="text-gray-700 dark:text-gray-300">
          Os valores do painel foram calculados a partir de microdados públicos
          e conferido contra os indicadores oficiais publicados pela RIPSA (Rede
          Interagencial de Informações para a Saúde).
        </p>
      </div>
    </div>

    <div id="app-notes" class="app-content-col app-gutter gap-2 md:gap-4">
      <div
        class="flex flex-col gap-3 rounded-ui-lg border border-gray-200 bg-gray-50 p-6 dark:border-gray-700 dark:bg-gray-800"
      >
        <h2 class="font-bold">Fontes</h2>
        <ul
          class="flex list-disc flex-col gap-2 pl-4 text-gray-700 dark:text-gray-300"
        >
          <li>
            <strong>Óbitos.</strong> Microdados do SIM (Sistema de Informações sobre
            Mortalidade), obtidos no Portal de Dados Abertos do Ministério da Saúde.
          </li>
          <li>
            <strong>População.</strong> Estimativas populacionais por município, sexo
            e idade simples do Ministério da Saúde (SVSA), publicadas pelo DATASUS
            (IBGE/POPSVS) para 2000 a 2025. São o denominador de todas as taxas. Somadas
            para o estado, reproduzem exatamente a projeção do IBGE (revisão 2024)
            por sexo e faixa etária.
          </li>
          <li>
            <strong>Cobertura do SIM.</strong> Indicador DEM.4.02 da RIPSA, que estima
            a proporção dos óbitos ocorridos que foram efetivamente registrados no
            sistema. Publicado por unidade da federação até 2023; por isso só o estado
            tem valor, e os municípios ficam sem dado.
          </li>
          <li>
            <strong>Malha.</strong> Malha municipal do Rio Grande do Sul da API de
            malhas do IBGE (qualidade mínima no mapa; qualidade intermediária para
            download).
          </li>
          <li>
            <strong>Agrupamento de causas.</strong> Segue as fichas de qualificação
            da RIPSA: MRT.3.01 (grupos de causas), MRT.4.01 a MRT.4.04 (causas externas
            por tipo e meio da agressão), MRT.5.02 (neoplasias malignas) e MRT.5.04
            (doenças do aparelho circulatório).
          </li>
        </ul>
      </div>
    </div>

    <div class="app-content-col app-gutter gap-2 md:gap-4">
      <div
        class="flex flex-col gap-3 rounded-ui-lg border border-gray-200 bg-gray-50 p-6 dark:border-gray-700 dark:bg-gray-800"
      >
        <h2 class="font-bold">Como as taxas são calculadas</h2>
        <div class="flex flex-col gap-3 text-gray-700 dark:text-gray-300">
          <p>
            A taxa bruta é a razão entre óbitos e população, por 100 mil
            habitantes. Ela depende da estrutura etária: um município mais
            envelhecido tende a ter taxa bruta maior mesmo com risco individual
            igual.
          </p>
          <p>
            Para permitir comparações entre municípios e ao longo do tempo, o
            painel calcula também a taxa padronizada por idade, pelo método
            direto, conforme a Nota Técnica nº 51/2025-CGIAE do Ministério da
            Saúde: as taxas específicas de 18 faixas etárias são aplicadas a uma
            população-padrão única, a do Brasil em 2022. As duas taxas aparecem
            sempre lado a lado.
          </p>
          <p>
            Os anos de 2020, 2021 e 2022 são destacados nos gráficos por causa
            da mortalidade atípica provocada pela pandemia de COVID-19.
          </p>
          <p>
            No mapa, as cinco classes de cor são definidas por quebras naturais
            de Jenks sobre as taxas padronizadas dos municípios no ano exibido
            (ou de toda a série, com a escala estável). No gráfico de evolução,
            a média móvel de três anos é centrada, a média do período e a
            tendência linear (mínimos quadrados) são calculadas sobre o
            intervalo de anos escolhido, para o território e o filtro de causa
            selecionados.
          </p>
        </div>
      </div>
    </div>

    <div class="app-content-col app-gutter gap-2 md:gap-4">
      <div
        class="flex flex-col gap-3 rounded-ui-lg border border-gray-200 bg-gray-50 p-6 dark:border-gray-700 dark:bg-gray-800"
      >
        <h2 class="font-bold">Limitações</h2>
        <ul
          class="flex list-disc flex-col gap-2 pl-4 text-gray-700 dark:text-gray-300"
        >
          <li>
            <strong>Início da série em 2000.</strong> Os dados do SIM codificados
            pela CID-10 existem desde 1996, mas as estimativas populacionais usadas
            como denominador começam em 2000.
          </li>
          <li>
            <strong>Dados preliminares.</strong> Os óbitos de 2025 ainda são preliminares
            (Portaria MS nº 116/2009) e serão consolidados ao longo de 2026; 2024
            já está consolidado. Os anos preliminares recebem indicação visual no
            painel.
          </li>
          <li>
            <strong>Sub-registro não corrigido.</strong> As taxas refletem os óbitos
            registrados, sem correção. Como a cobertura do SIM é publicada até 2023,
            os dois últimos anos seguem sem essa referência.
          </li>
          <li>
            <strong>Detalhamento.</strong> O estado e os 497 municípios por local
            de residência, grandes grupos de causas (com segundo nível onde a RIPSA
            o normatiza: neoplasias, cardiovasculares e causas externas) e dados anuais.
            Óbitos com município de residência ignorado (65 na série) entram só no
            total do estado.
          </li>
          <li>
            <strong>Municípios pequenos.</strong> Com poucos óbitos por ano, as taxas
            oscilam muito e a padronização amplifica o efeito de um único óbito em
            faixas etárias jovens. Leia a taxa sempre junto com o número de óbitos.
          </li>
          <li>
            <strong>Pinto Bandeira.</strong> Instalado em 2001, extinto em 2002 e
            recriado em 2013. Os óbitos de 2001 e 2002 registrados com o código histórico
            4314530 foram atribuídos ao município; em 2000 e de 2003 a 2012 ele não
            existia e seus dados estão em Bento Gonçalves, por isso fica sem valor
            nesses anos.
          </li>
          <li>
            <strong>Sexo.</strong> O SIM registra masculino, feminino e ignorado.
            A categoria "Todos" soma os três; os óbitos com sexo ignorado (menos de
            0,1% do total) não aparecem nas visões por sexo, mas entram em todas as
            taxas totais.
          </li>
        </ul>
      </div>

      <YearControl />
      <QualityChartCard active standalone padding="p-6" />
    </div>

    <div class="app-content-col app-gutter gap-2 md:gap-4">
      <div
        class="flex flex-col gap-3 rounded-ui-lg border border-gray-200 bg-gray-50 p-6 dark:border-gray-700 dark:bg-gray-800"
      >
        <h2 class="font-bold">Como citar</h2>
        <div class="flex flex-col gap-3 text-gray-700 dark:text-gray-300">
          <div data-copy class="flex flex-col gap-2">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-sm font-bold">ABNT</h3>
              <button
                type="button"
                data-copy-button
                class="chart-export-trigger"
              >
                <span data-copy-icon-default>
                  <Copy class="size-4" />
                </span>
                <span data-copy-icon-success hidden>
                  <Check class="size-4" />
                </span>
                <span data-copy-label aria-live="polite">Copiar</span>
              </button>
            </div>
            <p
              data-copy-source
              class="rounded-ui-sm border border-gray-200 bg-white p-4 text-sm dark:border-gray-700 dark:bg-gray-900"
            >
              <strong
                >Causa Mortis RS: mortalidade no Rio Grande do Sul, município
                por município</strong
              >. Versão 1.0. 2026. Painel interativo, réplica geográfica de
              ZANCHETTA JR., Celso; WEISE, Franklin; VELOSO, Pedro. Causa Mortis
              (https://causamortis.net). Acesso em: <span data-access-date
                >{formatAccessDate(new Date())}</span
              >.
            </p>
          </div>
          <p>
            Ao citar um gráfico ou tabela específica, indique também a visão, os
            filtros usados e a data de acesso, já que os dados de anos
            preliminares mudam. Os dados tratados podem ser citados a partir da
            página <a
              class="underline transition-opacity duration-200 hover:opacity-70"
              href="/dados">Dados</a
            >; os microdados originais devem ser atribuídos ao Ministério da
            Saúde (SIM/DATASUS) e ao IBGE.
          </p>
          <div data-copy class="flex flex-col gap-2">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-sm font-bold">BibTeX</h3>
              <button
                type="button"
                data-copy-button
                class="chart-export-trigger"
              >
                <span data-copy-icon-default>
                  <Copy class="size-4" />
                </span>
                <span data-copy-icon-success hidden>
                  <Check class="size-4" />
                </span>
                <span data-copy-label aria-live="polite">Copiar</span>
              </button>
            </div>
            <pre
              data-copy-source
              class="overflow-x-auto rounded-ui-sm border border-gray-200 bg-white p-4 text-xs dark:border-gray-700 dark:bg-gray-900"><code>{bibtex}</code></pre>
          </div>
        </div>
      </div>
    </div>

    <script>
      import { fetchCoverage } from "../lib/mortality/data";
      import { fetchDimensions } from "../lib/mortality/dimensions";
      import { FiltersStore } from "../lib/mortality/filters";
      import { formatAccessDate } from "../lib/mortality/format";

      const accessDate = document.querySelector("[data-access-date]");
      if (accessDate) accessDate.textContent = formatAccessDate(new Date());

      const container = document.getElementById("chart-quality");

      async function mountQualityChart(chartMount: HTMLElement): Promise<void> {
        const [dimensions, coverageTable, quality, main] = await Promise.all([
          fetchDimensions(),
          fetchCoverage(),
          import("../lib/mortality/charts/quality"),
          import("../lib/mortality/main"),
        ]);
        const store = new FiltersStore({
          location: "RS",
          sex: "Ambos",
          year: quality.findLatestCoverageYear(dimensions, coverageTable),
          yearStart: Math.min(...dimensions.years),
          yearEnd: Math.max(...dimensions.years),
          causeGroup: null,
          detailedSubgroup: null,
          externalCauseType: null,
          assaultMeans: null,
          pyramidMeasure: "rate",
        });

        const playback = main.createYearPlayback(dimensions, store);
        main.setupYearControl(document, dimensions, store, playback);

        chartMount.querySelector(".chart-placeholder")?.remove();
        quality.init(chartMount, store, dimensions);
      }

      if (container instanceof HTMLElement) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              observer.disconnect();
              void mountQualityChart(container);
            }
          },
          { rootMargin: "200px" },
        );
        observer.observe(container);
      }

      for (const copyBlock of document.querySelectorAll("[data-copy]")) {
        const button = copyBlock.querySelector("[data-copy-button]");
        const source = copyBlock.querySelector("[data-copy-source]");
        if (!(button instanceof HTMLButtonElement)) continue;
        if (!(source instanceof HTMLElement)) continue;

        const label = button.querySelector("[data-copy-label]");
        const defaultLabel = label?.textContent ?? "";
        const defaultIcon = button.querySelector("[data-copy-icon-default]");
        const successIcon = button.querySelector("[data-copy-icon-success]");
        let resetTimeout: ReturnType<typeof setTimeout> | undefined;

        button.addEventListener("click", () => {
          void navigator.clipboard
            .writeText(source.innerText.trim())
            .then(() => {
              clearTimeout(resetTimeout);
              if (label) label.textContent = "Copiado!";
              defaultIcon?.toggleAttribute("hidden", true);
              successIcon?.toggleAttribute("hidden", false);
              resetTimeout = setTimeout(() => {
                if (label) label.textContent = defaultLabel;
                defaultIcon?.toggleAttribute("hidden", false);
                successIcon?.toggleAttribute("hidden", true);
              }, 2000);
            })
            .catch((error: unknown) => {
              console.error("Falha ao copiar a referência.", error);
            });
        });
      }
    </script>
  </main>

  <Footer />
</Layout>
