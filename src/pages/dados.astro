---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../components/Layout.astro";
import DataDownloads from "../components/mortality/DataDownloads.astro";
---

<Layout
  title="Dados - Causa Mortis"
  description="Baixe as tabelas de mortalidade do Rio Grande do Sul e seus municípios (SIM/DATASUS e estimativas populacionais) em CSV ou JSON, por recorte."
>
  <Header />

  <main class="center-col gap-4">
    <div id="app-download" class="center w-full">
      <section class="app-content-col app-gutter gap-6 pt-6 pb-8 lg:pt-10">
        <DataDownloads />
      </section>
    </div>
  </main>

  <Footer />
</Layout>
